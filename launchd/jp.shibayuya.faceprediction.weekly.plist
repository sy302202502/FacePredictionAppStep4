<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>jp.shibayuya.faceprediction.weekly</string>

    <!-- 毎週月曜 AM 7:00 に実行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/shibayuya/git/FacePredictionAppStep4/python/weekly_pipeline.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/shibayuya/git/FacePredictionAppStep4</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>0</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/shibayuya/git/FacePredictionAppStep4/logs/weekly_pipeline.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/shibayuya/git/FacePredictionAppStep4/logs/weekly_pipeline.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
