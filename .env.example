# ============================================================
# .env.example — このファイルをコピーして .env を作成
# cp .env.example .env
# ============================================================

# ── データベース ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=faceapp
DB_USER=postgres
DB_PASSWORD=your_password_here

# Supabase 利用時は以下の形式
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PASSWORD=your_supabase_db_password

# ── Spring Boot (Docker 経由で注入) ──────────────────────────
# SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
# SPRING_DATASOURCE_USERNAME=${DB_USER}
# SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}
# UPLOAD_DIR=/data/uploads
# PYTHON_SCRIPT_DIR=/app/python

# ── LLM プロバイダー選択 ──────────────────────────────────────
# ollama / groq / gemini / openrouter
LLM_PROVIDER=ollama

# ── Ollama（LLM_PROVIDER=ollama の場合） ─────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b

# ── Groq（LLM_PROVIDER=groq の場合） ─────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# ⚠️ 2026-07時点でGroqは画像入力(vision)対応モデルの提供を終了。顔面分析には使えない
#    （コード側で自動的に最後尾へ回してGeminiを優先する）

# ── Google Gemini（LLM_PROVIDER=gemini の場合） ───────────────
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest  # 世代固定名は提供終了で404になるためエイリアス推奨

# ── OpenRouter（LLM_PROVIDER=openrouter の場合） ─────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# ── 通知 ─────────────────────────────────────────────────────

# ── Anthropic (将来用) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── アプリポート ──────────────────────────────────────────────
APP_PORT=8081

# ── Basic認証 ────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=your_secure_password_here
