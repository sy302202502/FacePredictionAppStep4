# digest固定: 再ビルドで中身が勝手に変わらないようにする。
# 更新手順: hub.docker.com で新しい digest を確認して差し替え → 再ビルド
FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28
WORKDIR /app

# タイムゾーン（JST）— weekly_pipeline の datetime.now() を日本時間に揃える
ENV TZ=Asia/Tokyo

# 軽量化: キャッシュなしインストール
# postgresql-client は deploy/vps_backup.sh が本番DBを pg_dump するために必要
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl tzdata postgresql-client \
    && ln -sf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime \
    && echo "Asia/Tokyo" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY python/ ./python/
# ※ .env はコピーしない（docker-compose の environment が優先される）
# ローカル開発時は .env を bind mount するか、override=False に頼る

# アップロードディレクトリ
RUN mkdir -p /data/uploads
VOLUME ["/data/uploads"]

# Python スクリプトはコマンド指定で実行（デーモンではない）
# 例: docker run faceprediction-python python python/race_specific_analyzer.py "日本ダービー"
CMD ["python", "--version"]
